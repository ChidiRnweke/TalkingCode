{
	"name": "talkingcode-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.30.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node scripts/server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"export:openapi": "PYTHONPATH=../backend/src ../backend/.venv/bin/python scripts/export-openapi.py",
		"generate:api": "pnpm run export:openapi && openapi-typescript openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "^9.39.2",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.575.0",
		"@playwright/test": "^1.58.1",
		"@shikijs/themes": "^3.23.0",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.18",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"@infisical/sdk": "^4.0.6",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.212.0",
		"@opentelemetry/auto-instrumentations-node": "^0.70.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.212.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.212.0",
		"@opentelemetry/resources": "^2.5.1",
		"@opentelemetry/sdk-logs": "^0.212.0",
		"@opentelemetry/sdk-node": "^0.212.0",
		"@opentelemetry/semantic-conventions": "^1.39.0",
		"@shikijs/langs": "^3.23.0",
		"bits-ui": "^2.16.2",
		"clsx": "^2.1.1",
		"dompurify": "^3.3.1",
		"dotenv": "^17.3.1",
		"lucide-svelte": "^0.575.0",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"runed": "^0.37.1",
		"shiki": "^3.23.0",
		"svelte-streamdown": "^3.0.1",
		"svelte-toolbelt": "^0.10.6",
		"tailwind-merge": "^3.5.0",
		"zod": "^4.3.6"
	}
}
