DATABASE_URL=postgresql+asyncpg://talkingcode:talkingcode@localhost:5432/talkingcode
OPENROUTER_API_KEY=
GITHUB_TOKEN=
INGESTION_API_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
# Phoenix (evals client only; tracing is routed via the OTel collector)
PHOENIX_BASE_URL=https://phoenix.chidinweke.be
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=talkingcode

DEFAULT_MODEL=anthropic/claude-3.5-sonnet
FALLBACK_MODEL=google/gemini-3-flash
MAX_ITERATIONS=8
MAX_TOOLS_PER_TURN=3
DEFAULT_TOOL_TIMEOUT=15

EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
INTENT_EXTRACTION_MODEL=deepseek/deepseek-v3.2

CURATED_MODELS=google/gemini-3-flash-preview,deepseek/deepseek-v3.2,moonshotai/kimi-k2.5,qwen/qwen3.5-plus-02-15,z-ai/glm-4.7,openai/gpt-5.1-codex-mini
DEFAULT_CHAT_MODEL=google/gemini-3-flash-preview

# Infisical (optional, set INFISICAL_ENABLED=1 to use)
INFISICAL_ENABLED=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_URL=https://app.infisical.com

# Infisical Admin (only needed for provisioning)
INFISICAL_ADMIN_CLIENT_ID=
INFISICAL_ADMIN_CLIENT_SECRET=
INFISICAL_ADMIN_PROJECT_ID=

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=talkingcode-backend
OTEL_ENVIRONMENT=development

# Database Provisioning (optional defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=talkingcode
DB_USER=talkingcode
DB_PASSWORD=talkingcode
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
